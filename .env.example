# Anthropic API key (required — powers the AI analysis and cleanup)
ANTHROPIC_API_KEY=sk-ant-...

# Microsoft Outlook (only if you have Outlook accounts)
# MS_CLIENT_ID=your-azure-app-client-id

# Yahoo (only if you have Yahoo accounts — generate app password in Yahoo settings)
# Password env var format: YAHOO_PASSWORD_{ACCOUNT_NAME} (spaces become underscores, all caps)
# YAHOO_PASSWORD_MY_YAHOO=your-yahoo-app-password

# Generic IMAP (only if you have IMAP accounts)
# Password env var format: IMAP_PASSWORD_{ACCOUNT_NAME}
# IMAP_PASSWORD_WORK=your-imap-password
